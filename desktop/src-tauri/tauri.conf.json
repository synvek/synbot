{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Synbot",
  "version": "0.11.3",
  "identifier": "com.synvek.synbot",
  "build": {
    "beforeDevCommand": "npm run prepare:sidecar && cd ../web && npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build:sidecar",
    "frontendDist": "../loading"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Synbot",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/synbot"]
  }
}
